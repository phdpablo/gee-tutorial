@article{georgeto2024b,
  title = {Quantitative {{Methods}} in {{Crossover Studies}}},
  author = {Georgeto, Sérgio Murilo and Rogers, Pablo},
  namea = {{Center for Open Science}},
  nameatype = {collaborator},
  date = {2024},
  publisher = {OSF},
  doi = {10.17605/OSF.IO/Q2MGK},
  url = {https://osf.io/q2mgk/},
  urldate = {2026-01-27},
  abstract = {The goal of the present research is to examine the quantitative techniques used in crossover investigations. The aim is to assess RCTs (randomized controlled trials) specifically related to physiotherapy and rehabilitation. By offering training on the use of Generalized Estimating Equation (GEE) and Analysis of Variance (ANOVA) Crossover in crossover experiments with open-source software, especially in the R language, it seeks to advance scientific methods in the fields of clinical and surgical research.}
}